# Copy to .env.development (default) or .env.production — the API loads
# .env.<env> where <env> comes from `--env` (default: development).
# Tests do not read this file: they use fake values from tests/setup/env.ts.

# ─── Server ──────────────────────────────────────────────────────────────────

PORT=8080
# development | production | test
NODE_ENV=development

# URL of the frontend (used for CORS and OAuth redirects)
FRONTEND_URL=http://localhost:5173

# Number of reverse proxies in front of the app (set 1 behind Render/Nginx/TLS proxy)
TRUST_PROXY=0

# ─── MongoDB ─────────────────────────────────────────────────────────────────

# Connection string — Atlas example: mongodb+srv://<user>:<pass>@<cluster>.mongodb.net
# Local example: mongodb://localhost:27017
MONGODB_URI=mongodb://localhost:27017

# Database name
DB_NAME=mern_db

# ─── Encryption ──────────────────────────────────────────────────────────────

# 32+ character random string used for symmetric encryption
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=change_me_to_a_32_character_random_string_here

# 32+ character random string used to sign the OAuth session cookie
# Generate with: openssl rand -hex 32
SESSION_SECRET=change_me_to_a_32_character_random_string_here

# ─── JWT ─────────────────────────────────────────────────────────────────────

# Required: min 10 chars. Use strong, unique secrets in production (32+ recommended)
# Generate with: openssl rand -hex 32
JWT_SECRET_ACCESS_TOKEN=your_access_token_secret_here
# Format: <number><unit> where unit = s | m | h | d
JWT_SECRET_ACCESS_TOKEN_EXP=15m

JWT_SECRET_REFRESH_TOKEN=your_refresh_token_secret_here
JWT_SECRET_REFRESH_TOKEN_EXP=7d

# ─── Redis ───────────────────────────────────────────────────────────────────

# Option A: full connection URL (takes priority)
# Redis Cloud: redis://default:<password>@<host>:<port>
# Local:       redis://localhost:6379
REDIS_URL=redis://localhost:6379

# Option B: host + port (used only if REDIS_URL is not set)
# REDIS_HOST=localhost
# REDIS_PORT=6379

# ─── Google OAuth 2.0 ────────────────────────────────────────────────────────

# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorised redirect URI must include the callback URL below
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:8080/api/v1/auth/google/callback

# ─── Email (Resend) ───────────────────────────────────────────────────────────

# Create an API key at https://resend.com
RESEND_API_KEY=re_your_resend_api_key_here

# Sender address — must be from a verified domain in Resend
FROM_EMAIL=no-reply@yourdomain.com
